{#- Logrotate configuration for Gaia -#}
{#- This template generates a logrotate config file -#}
{% set log_path = gaia_log_dir ~ '/*.log' -%}
{% set postrotate_cmd = '/usr/bin/systemctl reload ' ~ gaia_service_name ~ ' > /dev/null 2>&1 || true' -%}
# Logrotate configuration for Gaia
# Generated by Ansible
# Managed by: {{ ansible_managed | default('Ansible') }}

{{ log_path }} {
    size {{ gaia_logrotate_size }}
    rotate {{ gaia_logrotate_rotate }}
{% if gaia_logrotate_compress %}
    compress
    delaycompress
{% endif %}
    missingok
    notifempty
    create 0640 {{ gaia_user }} {{ gaia_group }}
    sharedscripts
    postrotate
        {{ postrotate_cmd }}
    endscript
}
