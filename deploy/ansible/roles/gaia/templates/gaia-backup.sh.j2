#!/bin/bash
# Gaia Backup Script
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Managed by: {{ ansible_managed | default('Ansible') }}
#
# This script creates backups of the Gaia database and certificates.
# Run manually or via cron for automated backups.

set -euo pipefail

# Configuration
BACKUP_DIR="{{ gaia_backup_dir }}"
DATA_DIR="{{ gaia_data_dir }}"
CERTS_DIR="{{ gaia_certs_dir }}"
CONFIG_FILE="{{ gaia_config_file }}"
GAIA_BIN="{{ gaia_binary_path }}"
RETENTION_DAYS={{ gaia_backup_retention_days }}
DATE=$(date +%Y%m%d_%H%M%S)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1"
}

# Create backup directory if it doesn't exist
mkdir -p "${BACKUP_DIR}"

log_info "Starting Gaia backup..."
log_info "Backup directory: ${BACKUP_DIR}"

# Check if Gaia is running
if systemctl is-active --quiet gaia; then
    GAIA_WAS_RUNNING=true
    log_info "Gaia daemon is running"
else
    GAIA_WAS_RUNNING=false
    log_warn "Gaia daemon is not running"
fi

# Backup database
if [ -f "${DATA_DIR}/gaia.db" ]; then
    DB_BACKUP="${BACKUP_DIR}/gaia_${DATE}.db"
    log_info "Backing up database to ${DB_BACKUP}"
    cp "${DATA_DIR}/gaia.db" "${DB_BACKUP}"
    chmod 600 "${DB_BACKUP}"
    log_info "Database backup complete: $(du -h ${DB_BACKUP} | cut -f1)"
else
    log_warn "Database file not found at ${DATA_DIR}/gaia.db"
fi

# Backup certificates
if [ -d "${CERTS_DIR}" ]; then
    CERTS_BACKUP="${BACKUP_DIR}/certs_${DATE}.tar.gz"
    log_info "Backing up certificates to ${CERTS_BACKUP}"
    tar -czf "${CERTS_BACKUP}" -C "$(dirname ${CERTS_DIR})" "$(basename ${CERTS_DIR})"
    chmod 600 "${CERTS_BACKUP}"
    log_info "Certificates backup complete: $(du -h ${CERTS_BACKUP} | cut -f1)"
else
    log_warn "Certificates directory not found at ${CERTS_DIR}"
fi

# Backup configuration
if [ -f "${CONFIG_FILE}" ]; then
    CONFIG_BACKUP="${BACKUP_DIR}/config_${DATE}.yaml"
    log_info "Backing up configuration to ${CONFIG_BACKUP}"
    cp "${CONFIG_FILE}" "${CONFIG_BACKUP}"
    chmod 600 "${CONFIG_BACKUP}"
    log_info "Configuration backup complete"
else
    log_warn "Configuration file not found at ${CONFIG_FILE}"
fi

# Clean up old backups
log_info "Cleaning up backups older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -name "gaia_*.db" -type f -mtime +${RETENTION_DAYS} -delete 2>/dev/null || true
find "${BACKUP_DIR}" -name "certs_*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete 2>/dev/null || true
find "${BACKUP_DIR}" -name "config_*.yaml" -type f -mtime +${RETENTION_DAYS} -delete 2>/dev/null || true

# Count remaining backups
DB_COUNT=$(find "${BACKUP_DIR}" -name "gaia_*.db" -type f 2>/dev/null | wc -l)
CERT_COUNT=$(find "${BACKUP_DIR}" -name "certs_*.tar.gz" -type f 2>/dev/null | wc -l)

log_info "Backup cleanup complete"
log_info "Current backups: ${DB_COUNT} database(s), ${CERT_COUNT} certificate archive(s)"

# Calculate backup size
TOTAL_SIZE=$(du -sh "${BACKUP_DIR}" 2>/dev/null | cut -f1)
log_info "Total backup size: ${TOTAL_SIZE}"

log_info "Gaia backup completed successfully!"

# Create a latest symlink for easy access
if [ -f "${DB_BACKUP}" ]; then
    ln -sf "${DB_BACKUP}" "${BACKUP_DIR}/gaia_latest.db"
fi
if [ -f "${CERTS_BACKUP}" ]; then
    ln -sf "${CERTS_BACKUP}" "${BACKUP_DIR}/certs_latest.tar.gz"
fi

exit 0
