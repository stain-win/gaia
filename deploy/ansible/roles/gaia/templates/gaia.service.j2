# Gaia Secrets Management Daemon - Systemd Service
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Managed by: {{ ansible_managed | default('Ansible') }}

[Unit]
Description=Gaia Secrets Management Daemon
Documentation=https://github.com/stain-win/gaia
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ gaia_user }}
Group={{ gaia_group }}
ExecStart={{ gaia_binary_path }} daemon start --config {{ gaia_config_file }}

# Restart configuration
Restart=on-failure
RestartSec=5s

# Working directory
WorkingDirectory={{ gaia_data_dir }}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gaia

# File descriptor limit
LimitNOFILE=65536

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Private /tmp directory
PrivateTmp=true

# Protect system directories
ProtectSystem=strict

# Protect home directories
ProtectHome=true

# Read-write paths (database, config, logs)
ReadWritePaths={{ gaia_data_dir }} {{ gaia_config_dir }} {{ gaia_log_dir }}

# Prevent privilege escalation
NoNewPrivileges=true

# Restrict kernel capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Protect kernel tunables
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true

# Protect control groups
ProtectControlGroups=true

# Restrict address families to IPv4/IPv6 only
RestrictAddressFamilies=AF_INET AF_INET6

# Restrict namespaces
RestrictNamespaces=true

# Restrict realtime scheduling
RestrictRealtime=true

# Disable personality changes
LockPersonality=true

# System call filter
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Memory deny write-execute
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
