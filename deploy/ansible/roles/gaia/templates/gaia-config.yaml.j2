# Gaia Secrets Management Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Managed by: {{ ansible_managed | default('Ansible') }}

# =============================================================================
# DAEMON CONFIGURATION
# =============================================================================
daemon:
  # gRPC server listen address
  listen_addr: "{{ gaia_listen_addr }}"

  # Database file path (encrypted BoltDB)
  db_file: "{{ gaia_db_file }}"

  # Operation timeout
  timeout: {{ gaia_timeout }}

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
log:
  # Log file path
  file_path: "{{ gaia_log_file }}"

  # Log level: debug, info, warn, error
  level: "{{ gaia_log_level }}"

# =============================================================================
# TLS CONFIGURATION
# =============================================================================
tls:
  # Directory containing certificates (ca.crt, server.crt, server.key)
  certs_directory: "{{ gaia_certs_dir }}"

  # Certificate validity period in days
  cert_expiry_days: {{ gaia_cert_expiry_days }}

{% if gaia_audit_enabled %}
# =============================================================================
# AUDIT LOGGING CONFIGURATION
# =============================================================================
audit:
  # Enable audit logging
  enabled: true

  # HMAC key for hashing sensitive values
  # IMPORTANT: Keep this secret and consistent across restarts
  hmac_key: "{{ gaia_audit_hmac_key }}"

  # Log incoming requests
  log_request: {{ gaia_audit_log_request | lower }}

  # Log outgoing responses
  log_response: {{ gaia_audit_log_response | lower }}

  # Audit log backends
  backends:
    # File backend with rotation
    - type: "file"
      path: "{{ gaia_audit_log_path }}"
      options:
        max_size_mb: {{ gaia_audit_max_size_mb }}
        max_backups: {{ gaia_audit_max_backups }}
        max_age_days: {{ gaia_audit_max_age_days }}

    # Internal backend for local queries
    - type: "internal"
      options:
        retention_days: {{ gaia_audit_retention_days }}
{% endif %}
