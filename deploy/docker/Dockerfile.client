# --- Build Stage ---
# Use the official Golang image to build the application.
FROM golang:1.25-alpine AS builder

# The Gaia application lives in its own Go module under apps/gaia
# (the repository root go.mod is a separate workspace module).
WORKDIR /src

# Copy the module files and download dependencies first for layer caching.
COPY apps/gaia/go.mod apps/gaia/go.sum ./
RUN go mod download

# Copy the application source code.
COPY apps/gaia/ ./

# Build the Gaia application binary.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /gaia .


# --- Final Stage ---
# Pinned base image for reproducible builds (see Dockerfile.daemon).
FROM alpine:3.22

# Create a non-root user for security.
RUN addgroup -S gaia && adduser -S gaia -G gaia

# Create a directory for certificates.
RUN mkdir -p /etc/gaia/certs && chown -R gaia:gaia /etc/gaia

# Copy the compiled Gaia binary from the builder stage.
COPY --from=builder /gaia /usr/local/bin/gaia

# Switch to the non-root user.
USER gaia

# Set a working directory.
WORKDIR /app

# The default command is to show the help message.
# This container is intended to be used with `docker-compose run` to execute specific commands.
ENTRYPOINT ["gaia"]
CMD ["--help"]
