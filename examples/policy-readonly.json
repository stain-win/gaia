{
  "client_name": "monitoring-service",
  "rules": [
    {
      "path": "*/production/*",
      "capabilities": ["read", "list"],
      "description": "Read-only access to all production namespaces"
    },
    {
      "path": "*/staging/*",
      "capabilities": ["read", "list"],
      "description": "Read-only access to all staging namespaces"
    }
  ]
}

